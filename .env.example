# Safe default. Broker mutations are impossible unless this is explicitly live.
TRADING_MODE=paper

# Required only for explicit Finam API access. Never commit real values.
FINAM_TOKEN=
FINAM_ACCOUNT_ID=

# Optional Arena and Telegram integrations.
FINAM_ARENA_API=
FINAM_ARENA_BASE_URL=https://arena.finam.ru
FINAM_ARENA_AUTO_TRADE_ENABLED=false
FINAM_ARENA_EXECUTOR_MUTATIONS_ENABLED=false
FINAM_H4_ALLOW_LIVE_DEMO_ORDERS=false
FINAM_H4_AUTONOMOUS_DEMO_ENABLED=false
TELEGRAM_BOT_TOKEN=
FINAM_H4_TELEGRAM_CHAT_ID=

# Optional network policy. Leave empty unless this runtime intentionally uses a proxy.
FINAM_EXPECTED_PROXY=
NO_PROXY=localhost,127.0.0.1,finam.ru,.finam.ru,api.finam.ru,www.finam.ru

# Optional local runtime paths.
FINAM_ARENA_POLICY_PATH=config/finam_arena_policy.json
HERMES_OPERATOR_JOURNAL=data/runtime/hermes_operator_actions.jsonl
